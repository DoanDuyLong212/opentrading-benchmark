+/** Independent development fixtures: no study task IDs, production replay or gold. */
+import { Server } from "@modelcontextprotocol/sdk/server/index.js"
+import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js"
+import { CallToolRequestSchema, ListToolsRequestSchema } from "@modelcontextprotocol/sdk/types.js"
+import { appendFileSync } from "node:fs"
+import { createHash } from "node:crypto"
+let executions=0
+const server = new Server({name:"independent-finance",version:"1"},{capabilities:{tools:{}}})
+const schema={type:"object" as const,properties:{entity:{type:"string"},year:{type:"integer"},format:{type:"string"}},required:["entity","year"],additionalProperties:false,"x-repair-fields":["format"]}
+server.setRequestHandler(ListToolsRequestSchema,async()=>({tools:[
+ {name:"metric_lookup",description:"Read a metric for the requested entity and year. format defaults to compact; only compact is available.",inputSchema:schema,annotations:{readOnlyHint:true}},
+ {name:"entity_resolve",description:"Resolve public entity aliases for the requested year.",inputSchema:schema,annotations:{readOnlyHint:true}},
+ {name:"place_order",description:"Submit an order (side effect).",inputSchema:schema,annotations:{readOnlyHint:false}},
+]}))
+server.setRequestHandler(CallToolRequestSchema,async(req)=>{
+ const executionId=`fixture-execution-${++executions}`
+ const args=req.params.arguments ?? {},entity=String(args.entity),tool=req.params.name
+ let result:Record<string,unknown>,isError=false
+ if(entity==="AUTH") {isError=true;result={error:{code:"unauthorized",retryable_with_corrected_arguments:false,message:"Credentials unavailable"}}}
+ else if(args.format && args.format!=="compact") {isError=true;result={error:{code:"unsupported_snapshot_query",retryable_with_corrected_arguments:true,message:"Use compact or omit format; rejected query is not evidence of no financial data.",argument_paths:["format"],allowed_public_variants:[{...args,format:"compact"}]}}}
+ else {
+  const data=tool==="entity_resolve" ? entity==="VOID" ? {resolved:null,candidates:[]} : {resolved:entity.replace("alias:",""),candidates:[entity.replace("alias:","")]} : {entity,year:args.year,value:entity.length+Number(args.year)%10,unit:"USD"}
+  const digest=(x:unknown)=>createHash("sha256").update(JSON.stringify(x)).digest("hex")
+  result={data,availability:entity==="VOID" ? "empty" : "available",provenance:{source:"independent-fixture",as_of:"2026-10-20T00:00:00Z"},receipt:{tool,request_hash:digest(args),response_hash:digest(data),call_id:executionId,data_scope:{entity,year:args.year},source:"independent-fixture",as_of:"2026-10-20T00:00:00Z"}}
+ }
+ appendFileSync(process.env.FINANCE_DEV_LEDGER!,JSON.stringify({tool,args,isError,result})+"\n")
+ return {isError,content:[{type:"text" as const,text:JSON.stringify(result)}],structuredContent:result}
+})
+await server.connect(new StdioServerTransport())
