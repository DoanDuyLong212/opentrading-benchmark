{
  "arm": "dsh",
  "model": "nvidia/nemotron-3.5-bolt-e4b",
  "provider": "nvidia",
  "effort": "none",
  "snapshot_tool_definitions": [
    {
      "name": "vn_quote_history",
      "description": "Frozen MCP snapshot; only snapshot_requests below are replayable. Supply all recorded non-default parameters; omitted parameters retain the real schema defaults. Read source/as_of from provenance and cite benchmark_evidence. snapshot_requests=[{\"symbol\": \"HPG\"}]",
      "inputSchema": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "days": {
            "type": "integer",
            "default": 365
          },
          "summary": {
            "type": "boolean",
            "default": false
          },
          "columns": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "interval": {
            "type": "string",
            "default": "1D"
          }
        },
        "required": [
          "symbol"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "vn_quote_history",
        "readOnlyHint": true
      }
    }
  ],
